rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.active == true;
    }
    function roleIs(r) { return activeUser() && userDoc().data.role == r; }
    function isAdmin() { return roleIs('admin'); }
    function isSalesman() { return roleIs('salesman'); }
    function isInventory() { return roleIs('inventory'); }
    function isRecovery() { return roleIs('recovery'); }
    function isMarketingDirector() { return roleIs('marketing_director'); }
    function isERPManager() { return roleIs('erp_manager'); }
    function isManagement() { return isAdmin() || isMarketingDirector() || isERPManager(); }
    function canApproveInvoices() { return isMarketingDirector(); }
    function canControlInvoices() { return isMarketingDirector() || isERPManager(); }
    function canManageExpenses() { return isAdmin() || isMarketingDirector() || isERPManager(); }

    function saleStatus(data) { return data.get('status', 'approved'); }
    function expenseStatus(data) { return data.get('status', 'draft'); }
    function saleDoc(saleId) { return get(/databases/$(database)/documents/sales/$(saleId)); }
    function saleAfter(saleId) { return getAfter(/databases/$(database)/documents/sales/$(saleId)); }
    function paymentAfter(paymentId) { return getAfter(/databases/$(database)/documents/payments/$(paymentId)); }
    function customerAfter(customerId) { return getAfter(/databases/$(database)/documents/customers/$(customerId)); }
    function saleBelongsToMe(saleId) {
      return saleDoc(saleId).data.salesmanId == request.auth.uid;
    }
    function validPaymentUpdate() {
      return saleStatus(resource.data) == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidAmount','paymentStatus','updatedAt'])
        && request.resource.data.paidAmount >= resource.data.paidAmount
        && request.resource.data.paidAmount <= resource.data.total;
    }
    function validCancellationReason() {
      return request.resource.data.cancellationReason is string
        && request.resource.data.cancellationReason.size() > 0;
    }

    match /users/{uid} {
      allow read: if activeUser();
      allow create, update: if isAdmin() || isERPManager();
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if activeUser();
      allow create: if isAdmin() || isERPManager();
      allow update: if isAdmin() || isERPManager() || isInventory()
        || (isMarketingDirector()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQty','updatedAt']));
      allow delete: if false;
    }

    match /customerIndex/{indexId} {
      allow read: if activeUser();
      allow create: if isAdmin() || isERPManager()
        || (isSalesman()
          && request.resource.data.createdBy == request.auth.uid
          && customerAfter(request.resource.data.customerId).data.assignedSalesmanId == request.auth.uid
          && customerAfter(request.resource.data.customerId).data.createdBy == request.auth.uid);
      allow update: if isAdmin() || isERPManager() || isMarketingDirector();
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isManagement() || isInventory() || isRecovery()
        || (isSalesman() && resource.data.assignedSalesmanId == request.auth.uid);

      allow create: if isAdmin() || isERPManager()
        || (isSalesman()
          && request.resource.data.assignedSalesmanId == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.active == true
          && request.resource.data.get('complimentarySchemeEligible', false) == false);

      allow update: if
        (
          (isMarketingDirector() || isERPManager())
          && (
            request.resource.data.get('active', true) == resource.data.get('active', true)
            || (
              resource.data.get('active', true) == true
              && request.resource.data.get('active', true) == false
              && request.resource.data.deactivationReason is string
              && request.resource.data.deactivationReason.size() > 0
              && request.resource.data.deactivatedBy == request.auth.uid
            )
          )
        )
        || (
          isAdmin()
          && request.resource.data.get('active', true) == resource.data.get('active', true)
        )
        || (
          isSalesman()
          && resource.data.assignedSalesmanId == request.auth.uid
          && request.resource.data.assignedSalesmanId == request.auth.uid
          && request.resource.data.get('active', true) == resource.data.get('active', true)
          && request.resource.data.get('customerCode', '') == resource.data.get('customerCode', '')
          && request.resource.data.get('currentBalance', 0) == resource.data.get('currentBalance', 0)
          && request.resource.data.get('complimentarySchemeEligible', false) == resource.data.get('complimentarySchemeEligible', false)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['address','routeArea','territory','creditLimit','creditDays','updatedAt'])
        );

      allow delete: if false;
    }

    match /sales/{saleId} {
      allow read: if isManagement() || isInventory() || isRecovery()
        || (isSalesman() && resource.data.salesmanId == request.auth.uid);

      allow create: if
        (
          isAdmin()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status in ['draft','pending_approval']
          && request.resource.data.dispatchEligible == false
          && request.resource.data.stockApplied == false
        )
        || (
          isSalesman()
          && request.resource.data.salesmanId == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'pending_approval'
          && request.resource.data.dispatchEligible == false
          && request.resource.data.stockApplied == false
        );

      allow update: if
        (
          isAdmin()
          && saleStatus(resource.data) == 'draft'
          && request.resource.data.status in ['draft','pending_approval']
          && request.resource.data.dispatchEligible == false
          && request.resource.data.stockApplied == false
        )
        || (
          isSalesman()
          && resource.data.salesmanId == request.auth.uid
          && resource.data.createdBy == request.auth.uid
          && saleStatus(resource.data) == 'draft'
          && request.resource.data.status == 'pending_approval'
          && request.resource.data.dispatchEligible == false
          && request.resource.data.stockApplied == false
        )
        || (
          canApproveInvoices()
          && saleStatus(resource.data) == 'pending_approval'
          && resource.data.createdBy != request.auth.uid
          && (
            (
              request.resource.data.status == 'approved'
              && request.resource.data.approvedBy == request.auth.uid
              && request.resource.data.reviewedBy == request.auth.uid
              && request.resource.data.dispatchEligible == true
              && request.resource.data.stockApplied == true
            )
            || (
              request.resource.data.status == 'rejected'
              && request.resource.data.reviewedBy == request.auth.uid
              && request.resource.data.dispatchEligible == false
            )
          )
        )
        || (
          canControlInvoices()
          && saleStatus(resource.data) != 'cancelled'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == request.auth.uid
          && request.resource.data.dispatchEligible == false
          && request.resource.data.stockApplied == false
          && validCancellationReason()
        )
        || (
          (isRecovery() || isAdmin())
          && validPaymentUpdate()
        );

      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isManagement() || isRecovery()
        || (isSalesman() && resource.data.salesmanId == request.auth.uid);

      allow create: if isAdmin() || isMarketingDirector() || isRecovery();

      allow update: if
        (isMarketingDirector() || isERPManager())
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['reversed','reversedBy','reversedAt','reversalReason'])
        && request.resource.data.reversed == true
        && request.resource.data.reversedBy == request.auth.uid
        && request.resource.data.reversalReason is string
        && request.resource.data.reversalReason.size() > 0;

      allow delete: if false;
    }

    match /ledgerEntries/{entryId} {
      allow read: if isManagement() || isRecovery()
        || (isSalesman() && resource.data.salesmanId == request.auth.uid);

      allow create: if
        activeUser()
        && request.resource.data.createdBy == request.auth.uid
        && (
          (
            request.resource.data.entryType == 'opening_balance'
            && (
              isAdmin()
              || isERPManager()
              || (
                isSalesman()
                && customerAfter(request.resource.data.sourceId).data.createdBy == request.auth.uid
                && customerAfter(request.resource.data.sourceId).data.assignedSalesmanId == request.auth.uid
              )
            )
          )
          || (
            request.resource.data.entryType in ['credit_sale','cash_sale','discount']
            && isMarketingDirector()
            && saleStatus(saleAfter(request.resource.data.sourceId).data) == 'approved'
            && saleAfter(request.resource.data.sourceId).data.approvedBy == request.auth.uid
          )
          || (
            request.resource.data.entryType == 'payment_received'
            && (isAdmin() || isMarketingDirector() || isRecovery())
            && paymentAfter(request.resource.data.sourceId).data.enteredBy == request.auth.uid
          )
          || (
            request.resource.data.entryType == 'invoice_cancel_reversal'
            && canControlInvoices()
            && saleStatus(saleAfter(request.resource.data.sourceId).data) == 'cancelled'
            && saleAfter(request.resource.data.sourceId).data.cancelledBy == request.auth.uid
          )
          || (
            request.resource.data.entryType == 'payment_reversal'
            && canControlInvoices()
            && paymentAfter(request.resource.data.sourceId).data.reversed == true
            && paymentAfter(request.resource.data.sourceId).data.reversedBy == request.auth.uid
          )
          || (
            request.resource.data.entryType in ['debit_note','credit_note','sales_return','approved_adjustment_debit','approved_adjustment_credit']
            && isManagement()
          )
        );

      allow update, delete: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if isAdmin() || isERPManager() || isInventory() || isMarketingDirector();
      allow create: if isAdmin() || isERPManager() || isInventory() || isMarketingDirector();
      allow update, delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if canManageExpenses();

      allow create: if canManageExpenses()
        && request.resource.data.enteredBy == request.auth.uid
        && request.resource.data.status in ['draft','pending_approval'];

      allow update: if canManageExpenses()
        && (
          (
            expenseStatus(resource.data) in ['draft','rejected']
            && request.resource.data.status in ['draft','pending_approval']
          )
          || (
            expenseStatus(resource.data) == 'pending_approval'
            && request.resource.data.status in ['approved','rejected']
            && (
              request.resource.data.status != 'approved'
              || request.resource.data.approvedBy == request.auth.uid
            )
          )
          || (
            expenseStatus(resource.data) != 'cancelled'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == request.auth.uid
            && request.resource.data.cancellationReason is string
            && request.resource.data.cancellationReason.size() > 0
          )
        );

      allow delete: if false;
    }

    match /cashBankAccounts/{accountId} {
      allow read: if canManageExpenses();
      allow create, update: if canManageExpenses();
      allow delete: if false;
    }

    match /auditTrail/{auditId} {
      allow read: if isAdmin() || isERPManager();
      allow create: if activeUser()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == userDoc().data.role;
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if activeUser();
      allow write: if isAdmin() || isERPManager();
    }

    match /counters/{counterId} {
      allow read: if activeUser();

      allow create: if
        isAdmin()
        || isERPManager()
        || (isSalesman() && counterId in ['invoice','customer'] && request.resource.data.next == 2)
        || (isMarketingDirector() && counterId == 'expense' && request.resource.data.next == 2);

      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1
        && (
          (counterId == 'invoice' && (isAdmin() || isSalesman()))
          || (counterId == 'customer' && (isAdmin() || isERPManager() || isSalesman()))
          || (counterId == 'expense' && canManageExpenses())
        );

      allow delete: if false;
    }
  }
}
